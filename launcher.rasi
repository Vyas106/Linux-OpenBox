configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               "󰍉";
    drun-display-format:        "{name}";
}

@theme "/dev/null"

* {
    font:                        "JetBrains Mono 10";
    bg:                          #0d0d0df2;
    bg-alt:                      #161616f2;
    fg:                          #d4d4d4;
    fg-dim:                      #777777;
    accent:                      #cccccc;
    selected:                    #222222;
    active:                      #50fa7b;
    urgent:                      #ff5555;
    border-col:                  #2e2e2e;
    background-color:            transparent;
    text-color:                  @fg;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       780px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               12px;
    border-color:                @border-col;
    background-color:            @bg;
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     16px;
    margin:                      0px;
    padding:                     24px;
    border:                      0px solid;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     12px 16px;
    border:                      1px solid;
    border-radius:               8px;
    border-color:                #2a2a2a;
    background-color:            @bg-alt;
    text-color:                  @fg;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @accent;
    font:                        "JetBrains Mono 12";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @fg;
    cursor:                      "text";
    placeholder:                 "Search system applications...";
    placeholder-color:           @fg-dim;
}

listview {
    enabled:                     true;
    columns:                     4;
    lines:                       4;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     12px;
    margin:                      4px 0px 0px 0px;
    padding:                     0px;
    border:                      0px solid;
    background-color:            transparent;
    text-color:                  @fg;
    cursor:                      "default";
}

element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     10px;
    margin:                      0px;
    padding:                     16px 10px;
    border:                      1px solid;
    border-color:                transparent;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @fg;
    cursor:                      "pointer";
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @fg;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  #f0f0f0;
    border:                      1px solid;
    border-color:                #3a3a3a;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        48px;
    cursor:                      inherit;
    horizontal-align:            0.5;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
